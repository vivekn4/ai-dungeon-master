# Copy to .env and fill in. Never commit a real key.
# Free Gemini key: https://aistudio.google.com/apikey
AI_API_KEY=

# Server port (Render sets this automatically)
PORT=3000

# AI model + endpoint (defaults work out of the box)
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional: comma-separated list of allowed frontend origins for CORS.
# Leave empty for same-origin / open development use.
FRONTEND_URL=
